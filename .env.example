# Copy to `.env` in the repository root (shared by the client and the server). Never commit `.env`.

# ---------------------------------------------------------------- Client (Vite: only VITE_* is exposed to the browser)
# Sign in automatically as the demo user "Ahmed Khan" (development only). Switch the role to test permissions.
VITE_DEV_FAKE_AUTH=true
VITE_DEV_FAKE_ROLE=student          # student | alumni | moderator | admin
# API base URL. Leave empty in development: Vite proxies /api and /uploads to the server on port 5000.
VITE_API_URL=

# ---------------------------------------------------------------- Server core
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nustconnect
CLIENT_URL=http://localhost:5173    # CORS origin and the base of links in emails
UPLOAD_DIR=uploads                  # local folder for multer uploads (gitignored)
MAX_UPLOAD_MB=5
RATE_LIMIT_WINDOW_MS=900000         # global API limiter: window (15 min)
RATE_LIMIT_MAX=300                  # global API limiter: requests per window per IP

# ---------------------------------------------------------------- Auth (A1)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ALLOWED_EMAIL_DOMAINS=nust.edu.pk,students.nust.edu.pk
AUTH_RATE_LIMIT_MAX=20              # register / login / reset / verify per IP per window
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOCKOUT_ATTEMPTS=5             # wrong passwords before an account is locked
AUTH_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- Email (nodemailer)
# Leave SMTP_HOST empty in development: emails are printed to the server console instead of being sent.
# For a real inbox use Ethereal (https://ethereal.email): host smtp.ethereal.email, port 587, and its generated user and password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NUSTConnect <no-reply@nustconnect.local>"

# ---------------------------------------------------------------- Dashboard (A2)
# Enables POST /api/dashboard/digest/run (send it as the X-Digest-Key header from a daily cron job). Leave empty to disable.
DIGEST_KEY=
